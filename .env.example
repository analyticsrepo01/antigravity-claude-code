# Google Gemini API Key (Bring Your Own Key)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Path to Google Antigravity binary (auto-detected if on PATH)
# AGY_BINARY_PATH=/home/user/.local/bin/agy

# Default Model and Effort
ANTIGRAVITY_MODEL=gemini-3.8-flash-high
ANTIGRAVITY_EFFORT=high

# Timeouts in seconds
ANTIGRAVITY_TIMEOUT=600
ANTIGRAVITY_CONSULT_TIMEOUT=180
